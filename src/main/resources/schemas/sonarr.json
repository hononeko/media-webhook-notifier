{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sonarr Webhook Payload",
  "type": "object",
  "properties": {
    "eventType": { "type": "string", "enum": ["Grab", "Download", "Health", "HealthIssue", "HealthRestored", "ManualInteractionRequired", "Test"] },
    "instanceName": { "type": "string" },
    "applicationUrl": { "type": "string" },
    "series": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "title": { "type": "string" },
        "path": { "type": "string" },
        "tvdbId": { "type": "integer" },
        "year": { "type": "integer" },
        "overview": { "type": "string" },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "coverType": { "type": "string" },
              "url": { "type": "string" },
              "remoteUrl": { "type": "string" }
            }
          }
        }
      }
    },
    "episodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "episodeNumber": { "type": "integer" },
          "seasonNumber": { "type": "integer" },
          "title": { "type": "string" },
          "overview": { "type": "string" }
        }
      }
    },
    "episodeFile": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "relativePath": { "type": "string" },
        "path": { "type": "string" },
        "quality": { "type": "string" },
        "qualityVersion": { "type": "integer" },
        "releaseGroup": { "type": "string" },
        "sceneName": { "type": "string" },
        "size": { "type": "integer" },
        "mediaInfo": {
          "type": "object",
          "properties": {
            "audioChannels": { "type": "number" },
            "audioCodec": { "type": "string" },
            "audioLanguages": {
              "type": "array",
              "items": { "type": "string" }
            },
            "height": { "type": "integer" },
            "width": { "type": "integer" },
            "subtitles": {
              "type": "array",
              "items": { "type": "string" }
            },
            "videoCodec": { "type": "string" },
            "videoDynamicRange": { "type": "string" },
            "videoDynamicRangeType": { "type": "string" }
          }
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "quality": { "type": "string" },
        "qualityVersion": { "type": "integer" },
        "releaseGroup": { "type": "string" },
        "releaseTitle": { "type": "string" },
        "indexer": { "type": "string" },
        "size": { "type": "integer" },
        "indexerFlags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "downloadId": { "type": "string" },
    "isUpgrade": { "type": "boolean" },
    "downloadClient": { "type": "string" },
    "downloadInfo": {
      "type": "object",
      "properties": {
        "quality": { "type": "string" },
        "qualityVersion": { "type": "integer" },
        "title": { "type": "string" },
        "indexer": { "type": "string" },
        "size": { "type": "integer" }
      }
    },
    "downloadStatus": { "type": "string" },
    "downloadStatusMessages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "messages": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "level": { "type": "string" },
    "message": { "type": "string" },
    "type": { "type": "string" },
    "wikiUrl": { "type": "string" }
  },
  "required": ["eventType"]
}
