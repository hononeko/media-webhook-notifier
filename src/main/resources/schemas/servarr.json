{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Servarr Generic Webhook Payload",
  "type": "object",
  "properties": {
    "eventType": {
      "type": "string",
      "enum": [
        "Grab",
        "Download",
        "Health",
        "HealthIssue",
        "HealthRestored",
        "ManualInteractionRequired",
        "Test"
      ]
    },
    "instanceName": { "type": "string" },
    "applicationUrl": { "type": "string" },
    "series": { "type": "object" },
    "movie": { "type": "object" },
    "episodes": { "type": "array" },
    "release": { "type": "object" },
    "downloadId": { "type": "string" },
    "downloadClient": { "type": "string" },
    "isUpgrade": { "type": "boolean" },
    "level": { "type": "string" },
    "message": { "type": "string" },
    "type": { "type": "string" },
    "wikiUrl": { "type": "string" },
    "reason": { "type": "string" }
  },
  "required": ["eventType"]
}
