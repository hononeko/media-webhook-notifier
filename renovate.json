{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":semanticCommitScope(deps)",
    "mergeConfidence:all-badges",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "dependencyDashboard": true,
  "timezone": "Europe/Chisinau",
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "renovate",
    "dependencies"
  ],
  "automergeType": "pr",
  "prHeader": "## 🤖 Renovate: Dependency Maintenance",
  "packageRules": [
    {
      "description": "Group Kotlin compiler, plugins, and official libraries",
      "matchPackageNames": [
        "org.jetbrains.kotlin/**",
        "org.jetbrains.kotlinx/**",
        "org.jetbrains.kotlin.*"
      ],
      "groupName": "Kotlin & Kotlinx"
    },
    {
      "description": "Group all Ktor server and client dependencies",
      "matchPackageNames": [
        "io.ktor/**"
      ],
      "groupName": "Ktor"
    },
    {
      "description": "Group Arrow-kt functional library ecosystem",
      "matchPackageNames": [
        "io.arrow-kt/**"
      ],
      "groupName": "Arrow-kt"
    },
    {
      "description": "Group GraalVM native build tools, GitHub action, and base images",
      "matchPackageNames": [
        "ghcr.io/graalvm/**",
        "org.graalvm.buildtools/**",
        "graalvm/setup-graalvm"
      ],
      "groupName": "GraalVM"
    },
    {
      "description": "Group Gradle wrapper and Gradle GitHub actions",
      "matchPackageNames": [
        "gradle",
        "org.gradle/**",
        "gradle/actions/**",
        "gradle/actions"
      ],
      "groupName": "Gradle"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!ghcr.io/graalvm/**",
        "!org.graalvm.buildtools/**",
        "!graalvm/setup-graalvm",
        "!gradle/actions/**",
        "!gradle/actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
